{
  "name": "iam-service-principal-snippets",
  "displayName": "AWS IAM Service Principal Snippets",
  "description": "Context-aware completions for documented AWS IAM service principals in JSON, YAML, Terraform and AWS CDK.",
  "author": "Danny Steenman",
  "version": "1.90.0",
  "publisher": "dannysteenman",
  "icon": "images/iam-service-principal-snippets-extension-icon.png",
  "homepage": "https://towardsthecloud.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/towardsthecloud/vscode-iam-service-principal-snippets.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#2B2C33",
    "theme": "dark"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "aws",
    "policy",
    "iam",
    "principal",
    "security"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml",
    "onLanguage:terraform",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node out/test/run.js",
    "test:python": ".venv/bin/python -m unittest discover -s tests -v",
    "validate:catalog": ".venv/bin/python src/update_service_principals.py --check",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  },
  "contributes": {
    "languages": [
      { "id": "json", "extensions": [".template"] },
      { "id": "yaml", "extensions": [".template"] },
      {
        "id": "terraform",
        "aliases": [
          "Terraform",
          "terraform"
        ],
        "extensions": [
          ".tf",
          ".tfvars"
        ]
      }
    ]
  }
}
